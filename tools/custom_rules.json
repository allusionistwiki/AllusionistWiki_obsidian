{
  "description": "fix_typo.py カスタム置換ルールテンプレート",
  "usage": "python fix_typo.py --scan <dir> --rules custom_rules.json",
  "format": "(検索文字列, 置換文字列, 説明) をJSON配列で指定",
  "rules": [
    ["トリシーラ", "トリシューラ", "トリシーラ→トリシューラ: シュ(U+30B7 U+30E5)付きが正しい"],
    ["候选人", "候補者", "候选人→候補者: 简 '候'/'选'/'人'"],
    ["单词", "単語", "单词→単語: 简 '单'"],
    ["价值", "価値", "价值→価値: 简 '价'"],
    ["选择", "選択", "选择→選択: 简 '选'/'择'"],
    ["杂", "雑", "杂→雑: 简 '杂'"],
    ["务", "務", "务→務: 简 '务'"],
    ["队", "隊", "队→隊: 简 '队'"],
    ["义", "義", "义→義: 简 '义'"],
    ["发", "発", "发→発: 简 '发'"],
    ["时", "時", "时→時: 简 '时'"]
  ]
}
